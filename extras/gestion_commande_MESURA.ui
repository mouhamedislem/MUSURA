                    <property name="cursor">
                     <cursorShape>PointingHandCursor</cursorShape>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">QPushButton {
    background-color: #641C2A;      /* Bordeaux */
    color: #F5F0E6;                 /* Ivoire */
    border: 2px solid #641C2A;
    border-radius: 8px;
    padding: 8px 20px;
    font-family: &quot;Georgia&quot;, &quot;Times New Roman&quot;, serif;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #D8A7A7;      /* Rose poudré */
    color: #171717;                 /* Noir */
    border: 2px solid #641C2A;
}

QPushButton:pressed {
    background-color: #171717;      /* Noir */
    color: #F5F0E6;
    border: 2px solid #171717;
}

QPushButton:disabled {
    background-color: #8B7D75;      /* Taupe */
    color: #F5F0E6;
    border: 2px solid #8B7D75;
}

QPushButton:focus {
    outline: none;
    border: 2px solid #7A7B62;      /* Sauge */
}</string>
                    </property>
                    <property name="text">
                     <string>Ajouter</string>
                    </property>
