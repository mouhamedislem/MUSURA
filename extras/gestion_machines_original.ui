<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="styleSheet">
   <string notr="true">
/* =====================================================================
   MESURA - Smart High Fashion Workshop
   Feuille de style de l'application (maquette statique)
   Palette utilisee :
     Bordeaux   #641C2A      Noir        #171717
     Creme      #F5F0E6      Gris/brun   #8B7D75
     Rose       #D8A7A7      Vert olive  #7A7B62
   Typographie :
     Titres : Cormorant Garamond     Textes : Montserrat
   (polices embarquees dans fonts/, voir main.cpp)
   ===================================================================== */
/* ---------------------------------------------------------------------
   1. BASE
   --------------------------------------------------------------------- */
QMainWindow,
QDialog {
    background: #F5F0E6;
}
QWidget {
    font-family: &quot;Montserrat&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
    color: #171717;
    background: transparent;
}
/* Fond crème de la fenetre : les selecteurs par identifiant ont une
   specificite superieure a &quot;QWidget { background: transparent }&quot; et
   empechent tout fond noir dans les zones sans widget explicite
   (marges, entete, espaces entre cartes). */
QMainWindow#MainWindow,
QWidget#centralwidget {
    background: #F5F0E6;
}
/* ---------------------------------------------------------------------
   2. ROLES TYPOGRAPHIQUES (proprietes &quot;role&quot; posees dans mainwindow.ui)
   --------------------------------------------------------------------- */
QLabel[role=&quot;h1&quot;] {
    font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 42px;
    font-weight: 700;
    color: #171717;
}
QLabel[role=&quot;h2&quot;] {
    font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 30px;
    font-weight: 600;
    color: #641C2A;
}
QLabel[role=&quot;h3&quot;] {
    font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 24px;
    font-weight: 500;
    color: #171717;
}
QLabel[role=&quot;petittexte&quot;] {
    font-size: 13px;
    font-weight: 400;
    color: #8B7D75;
}
QLabel[role=&quot;labelchamp&quot;] {
    font-size: 13px;
    font-weight: 500;
    color: #8B7D75;
}
QLabel[role=&quot;valeur&quot;] {
    font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 34px;
    font-weight: 700;
    color: #641C2A;
}
QLabel[role=&quot;badge&quot;] {
    background: #641C2A;
    color: #F5F0E6;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[role=&quot;pastille&quot;] {
    border-radius: 6px;
    background: #8B7D75;
}
/* ---------------------------------------------------------------------
   3. CARTES / CADRES
   --------------------------------------------------------------------- */
QFrame[role=&quot;card&quot;] {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    border-radius: 8px;
}
QFrame[role=&quot;champ&quot;] {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    border-radius: 6px;
}
QFrame[role=&quot;barre&quot;] {
    border-radius: 4px 4px 0 0;
    background: #D8A7A7;
}
QFrame[role=&quot;axe&quot;] {
    background: #8B7D75;
    border: none;
    max-height: 1px;
}
/* ---------------------------------------------------------------------
   4. BOUTONS
   --------------------------------------------------------------------- */
QPushButton {
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
    min-height: 40px;
}
QPushButton[role=&quot;principal&quot;] {
    background: #641C2A;
    border: 1px solid #641C2A;
    color: #F5F0E6;
}
QPushButton[role=&quot;principal&quot;]:hover   { background: #7C2536; }
QPushButton[role=&quot;principal&quot;]:pressed { background: #4E1520; }
QPushButton[role=&quot;secondaire&quot;] {
    background: #F5F0E6;
    border: 1px solid #641C2A;
    color: #641C2A;
}
QPushButton[role=&quot;secondaire&quot;]:hover   { background: #EDE5D8; }
QPushButton[role=&quot;secondaire&quot;]:pressed { background: #E3D9C8; }
QPushButton[role=&quot;danger&quot;] {
    background: #171717;
    border: 1px solid #171717;
    color: #F5F0E6;
}
QPushButton[role=&quot;danger&quot;]:hover { background: #2C2C2C; }
QPushButton[role=&quot;fantome&quot;] {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    color: #641C2A;
}
QPushButton[role=&quot;fantome&quot;]:hover { background: #EDE5D8; }
/* Boutons de la barre laterale */
QPushButton[role=&quot;menu&quot;],
QPushButton[role=&quot;menuActif&quot;],
QPushButton[role=&quot;menuDeconnexion&quot;] {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #F5F0E6;
    text-align: left;
    padding-left: 14px;
    padding-right: 10px;
    font-size: 14px;
    font-weight: 500;
    min-height: 44px;
}
QPushButton[role=&quot;menu&quot;]:hover { background: #262626; }
QPushButton[role=&quot;menuActif&quot;] {
    background: #641C2A;
    color: #F5F0E6;
    font-weight: 600;
}
QPushButton[role=&quot;menuDeconnexion&quot;] {
    color: #F5F0E6;
    font-weight: 500;
}
QPushButton[role=&quot;menuDeconnexion&quot;]:hover { background: #262626; }
/* Bouton de notification (cloche) */
QToolButton#btnNotifications {
    background: transparent;
    border: none;
    border-radius: 22px;
}
QToolButton#btnNotifications:hover { background: #EDE5D8; }
/* ---------------------------------------------------------------------
   5. CHAMPS DE SAISIE
   --------------------------------------------------------------------- */
QLineEdit,
QComboBox,
QDateEdit,
QDoubleSpinBox {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 40px;
    font-size: 14px;
    color: #171717;
    selection-background-color: #D8A7A7;
    selection-color: #171717;
}
QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QDoubleSpinBox:focus {
    border: 1px solid #641C2A;
}
QLineEdit[role=&quot;sansbordure&quot;] {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 24px;
}
QLineEdit[role=&quot;sansbordure&quot;]:focus { border: none; }
QLineEdit[role=&quot;lecture&quot;] {
    background: #EFE9DD;
    color: #171717;
    font-weight: 600;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #641C2A;
    margin-right: 12px;
}
QComboBox QAbstractItemView {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    color: #171717;
    selection-background-color: #D8A7A7;
    selection-color: #171717;
}
QTextEdit {
    background: #F5F0E6;
    border: 1px solid #8B7D75;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #171717;
}
QTextEdit:focus { border: 1px solid #641C2A; }
/* ---------------------------------------------------------------------
   6. TABLEAU DES MACHINES
   --------------------------------------------------------------------- */
QTableWidget#tableMachines {
    background: #F5F0E6;
    alternate-background-color: #EFE9DD;
    border: none;
    border-radius: 6px;
    gridline-color: #DFD6C7;
    font-size: 13px;
    color: #171717;
    selection-background-color: #D8A7A7;
    selection-color: #171717;
}
QHeaderView::section {
    background: #171717;
    color: #F5F0E6;
    border: none;
    border-right: 1px solid #333333;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 600;
    font-family: &quot;Montserrat&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
}
QTableWidget#tableMachines::item {
    padding: 6px 8px;
    border: none;
}
QTableWidget#tableMachines::item:selected {
    background: #D8A7A7;
    color: #171717;
}
/* ---------------------------------------------------------------------
   7. ZONES DE DEROULEMENT
   --------------------------------------------------------------------- */
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
}
QScrollArea#scrollAreaFiche {
    border-left: 1px solid #DFD6C7;
    background: #F5F0E6;
}
QScrollBar:vertical {
    background: #EFE9DD;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #8B7D75;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar:horizontal {
    background: #EFE9DD;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #8B7D75;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: none;
    border: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}
/* ---------------------------------------------------------------------
   8. BARRE LATERALE NOIRE
   --------------------------------------------------------------------- */
#sidebar {
    background: #171717;
}
/* ---------------------------------------------------------------------
   9. COULEURS DES BARRES DU GRAPHIQUE
   --------------------------------------------------------------------- */
QFrame[role=&quot;barreCouture&quot;]    { background: #641C2A; border-radius: 5px 5px 0 0; }
QFrame[role=&quot;barreSurjeteuse&quot;] { background: #7A7B62; border-radius: 5px 5px 0 0; }
QFrame[role=&quot;barreBroderie&quot;]   { background: #D8A7A7; border-radius: 5px 5px 0 0; }
QFrame[role=&quot;barreDecoupe&quot;]    { background: #8B7D75; border-radius: 5px 5px 0 0; }
QFrame[role=&quot;barreAutres&quot;]     { background: #171717; border-radius: 5px 5px 0 0; }
/* ---------------------------------------------------------------------
   10. GRAPHIQUE EN DONUT + LEGENDE
   --------------------------------------------------------------------- */
QLabel[role=&quot;donutCentre&quot;] {
    font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 30px;
    font-weight: 700;
    color: #641C2A;
    background: transparent;
}
QLabel[role=&quot;legende&quot;] {
    font-size: 13px;
    color: #171717;
    background: transparent;
}
/* ---------------------------------------------------------------------
   11. PANNEAU &quot;FICHE MACHINE&quot;
   --------------------------------------------------------------------- */
#frameFiche {
    background: #F5F0E6;
}
QLabel[role=&quot;ficheValeur&quot;] {
    font-size: 14px;
    font-weight: 600;
    color: #171717;
    background: transparent;
}
QLabel#labelAideTri {
    color: #8B7D75;
    font-size: 12px;
    font-style: italic;
}
QPushButton#btnRechercher, QPushButton#btnReinitialiser {
    background-color: #F5F0E6;
    color: #641C2A;
    border: 1px solid #641C2A;
    border-radius: 6px;
    padding: 0 16px;
    min-height: 40px;
    font-family: &quot;Montserrat&quot;;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#btnRechercher:hover, QPushButton#btnReinitialiser:hover {
    background-color: #D8A7A7;
    color: #171717;
}
QPushButton#btnRechercher:pressed, QPushButton#btnReinitialiser:pressed {
    background-color: #641C2A;
    color: #F5F0E6;
}
QLineEdit#lineEditIdentifiant, QLineEdit#lineEditDateAchat {
    color: #8B7D75;
}
   </string>
