             <widget class="QFrame" name="pageClients">
              <property name="styleSheet">
               <string notr="true">
QFrame#pageClients { background-color: #F5F0E6; }
QFrame#pageClients QLabel { background: transparent; border: none; color: #171717; font-family: 'Montserrat'; font-size: 12px; }
QFrame#pageClients QLabel#labelTitreClients { font-family: 'Cormorant Garamond'; font-size: 32px; font-weight: bold; }
QFrame#pageClients QLabel#labelSousTitreClients, QFrame#pageClients QLabel#labelTrierClient { color: #8B7D75; font-size: 13px; }
QFrame#pageClients QLabel#labelListeClient { font-size: 16px; font-weight: bold; }
QFrame#pageClients QFrame#frameFormClient QLabel#labelFormTitleClient { font-family: 'Cormorant Garamond'; font-size: 22px; font-weight: bold; }
QFrame#pageClients QFrame#frameFormClient QLabel { font-weight: 600; }
QFrame#pageClients QLineEdit { background-color: #FFFFFF; border: 1px solid #8B7D75; border-radius: 6px; padding: 4px 12px; font-family: 'Montserrat'; font-size: 13px; color: #171717; min-height: 34px; }
QFrame#pageClients QLineEdit:focus { border: 1px solid #641C2A; }
QFrame#pageClients QLineEdit:read-only { background-color: #F5F0E6; color: #8B7D75; }
QFrame#pageClients QComboBox { background-color: #FFFFFF; border: 1px solid #8B7D75; border-radius: 6px; padding: 4px 12px; font-family: 'Montserrat'; font-size: 13px; color: #171717; min-height: 34px; }
QFrame#pageClients QComboBox::drop-down { border: none; width: 24px; }
QFrame#pageClients QComboBox QAbstractItemView { background: #FFFFFF; color: #171717; selection-background-color: #D8A7A7; selection-color: #171717; }
QFrame#pageClients QPushButton { border: none; border-radius: 6px; font-family: 'Montserrat'; font-size: 13px; font-weight: bold; min-height: 40px; padding: 0 14px; }
QFrame#pageClients QPushButton#btnRechercherClient { background-color: #171717; color: #F5F0E6; }
QFrame#pageClients QPushButton#btnReinitialiserClient, QFrame#pageClients QPushButton#btnSupprimerClient, QFrame#pageClients QPushButton#btnSupprimerFicheClient { background-color: #8B7D75; color: #F5F0E6; }
QFrame#pageClients QPushButton#btnAjouterClient, QFrame#pageClients QPushButton#btnExporterClient, QFrame#pageClients QPushButton#btnAjouterFicheClient { background-color: #641C2A; color: #F5F0E6; }
QFrame#pageClients QPushButton#btnModifierClient, QFrame#pageClients QPushButton#btnModifierFicheClient { background-color: #7A7B62; color: #F5F0E6; }
QFrame#pageClients QPushButton#btnConsulterClient { background-color: #D8A7A7; color: #171717; }
QFrame#pageClients QPushButton#btnNouveauFormulaireClient { background-color: #FFFFFF; color: #171717; border: 1px solid #8B7D75; }
QFrame#pageClients QTableWidget { background-color: #FFFFFF; border: 1px solid #8B7D75; border-radius: 8px; font-family: 'Montserrat'; font-size: 12px; color: #171717; gridline-color: #F5F0E6; selection-background-color: #D8A7A7; selection-color: #171717; }
QFrame#pageClients QHeaderView::section { background-color: #171717; color: #F5F0E6; font-family: 'Montserrat'; font-size: 12px; font-weight: bold; padding: 8px 10px; border: none; }
QFrame#pageClients QFrame#frameFormClient { background-color: #FFFFFF; border: 1px solid #8B7D75; border-radius: 8px; }
</string>
