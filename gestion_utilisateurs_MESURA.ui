QFrame#pageMotDePasseOublie, QFrame#resetArea, QFrame#resetCard { background-color: #F5F0E6; border: none; }
QFrame#brandPanelReset { background-color: #171717; }
QLabel#labelBrandReset { color: #F5F0E6; font-family: &quot;Cormorant Garamond&quot;; font-size: 40px; font-weight: 700; }
QLabel#labelBrandSubReset { color: #D8A7A7; font-size: 13px; }
QLabel#labelResetTitre { font-family: &quot;Cormorant Garamond&quot;; font-size: 40px; font-weight: 700; color: #171717; }
QLabel#labelResetSub { color: #8B7D75; font-size: 14px; }
QLabel#labelResetEmail, QLabel#labelResetCode, QLabel#labelResetMdp { color: #8B7D75; font-size: 13px; }
QPushButton#btnEnvoyerCode, QPushButton#btnConfirmerReset { background-color: #641C2A; color: #F5F0E6; border: none; border-radius: 6px; padding: 0 16px; min-height: 42px; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
QPushButton#btnEnvoyerCode:hover, QPushButton#btnConfirmerReset:hover { background-color: #8B7D75; }
QPushButton#btnEnvoyerCode:pressed, QPushButton#btnConfirmerReset:pressed { background-color: #171717; }
QPushButton#btnEnvoyerCode:disabled, QPushButton#btnConfirmerReset:disabled { background-color: #D8A7A7; }
QPushButton#btnRetourConnexion { background-color: #F5F0E6; color: #641C2A; border: 1px solid #641C2A; border-radius: 6px; padding: 0 16px; min-height: 40px; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
QPushButton#btnRetourConnexion:hover { background-color: #D8A7A7; color: #171717; }
QPushButton#btnRetourConnexion:pressed { background-color: #641C2A; color: #F5F0E6; }
