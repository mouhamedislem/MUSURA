QMainWindow, QWidget#centralwidget, QStackedWidget, QFrame#loginArea, QFrame#loginCard, QFrame#pageLogin, QFrame#appPage, QFrame#modulesArea, QFrame#pageUtilisateurs, QFrame#listPanel { background-color: #F5F0E6; border: none; }
QLabel { color: #171717; font-family: &quot;Montserrat&quot;; font-size: 14px; }
QFrame#brandPanel { background-color: #171717; }
QLabel#labelBrand { color: #F5F0E6; font-family: &quot;Cormorant Garamond&quot;; font-size: 40px; font-weight: 700; }
QLabel#labelBrandSub { color: #D8A7A7; font-size: 13px; }
QLabel#labelConnexion { font-family: &quot;Cormorant Garamond&quot;; font-size: 40px; font-weight: 700; color: #171717; }
QLabel#labelConnexionSub { color: #8B7D75; font-size: 14px; }
QLabel#labelLoginEmail, QLabel#labelLoginMdp { color: #8B7D75; font-size: 13px; }
QFrame#sidebar { background-color: #171717; }
QLabel#labelLogo { color: #F5F0E6; font-family: &quot;Cormorant Garamond&quot;; font-size: 29px; font-weight: 700; }
QLabel#labelSousTitre { color: #BFA9A0; font-size: 11px; font-weight: 500; }
QFrame#sidebar QPushButton { background-color: transparent; color: #F5F0E6; text-align: left; padding: 0 18px; border: none; border-radius: 9px; min-height: 46px; font-family: &quot;Montserrat&quot;; font-size: 13px; font-weight: 500; }
QFrame#sidebar QPushButton:hover { background-color: #262626; }
QFrame#sidebar QPushButton:checked { background-color: #641C2A; color: #FFFFFF; border-left: 3px solid #D8A7A7; padding-left: 15px; }
QPushButton#btnDeconnexion { color: #D8A7A7; border-top: 1px solid #2D2D2D; border-radius: 0; padding-top: 8px; }
QFrame#sidebar QPushButton#btnDeconnexion:hover { background-color: #262626; }
QLabel#labelTitre { font-family: &quot;Cormorant Garamond&quot;; font-size: 40px; font-weight: 700; color: #171717; }
QLineEdit { background-color: #F5F0E6; color: #171717; border: 1px solid #8B7D75; border-radius: 6px; padding: 0 12px; min-height: 40px; font-family: &quot;Montserrat&quot;; font-size: 14px; }
QLineEdit:focus { border: 1px solid #641C2A; }
QLineEdit#lineEditId, QLineEdit#lineEditDateCreation { color: #8B7D75; }
QPushButton#btnAjouter, QPushButton#btnConnexion { background-color: #641C2A; color: #F5F0E6; border: none; border-radius: 6px; padding: 0 16px; min-height: 42px; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
QPushButton#btnAjouter:hover, QPushButton#btnConnexion:hover { background-color: #8B7D75; }
QPushButton#btnAjouter:pressed, QPushButton#btnConnexion:pressed { background-color: #171717; }
QPushButton#btnAjouter:disabled, QPushButton#btnConnexion:disabled { background-color: #D8A7A7; }
QPushButton#btnRechercher, QPushButton#btnReinitialiser, QPushButton#btnExporter, QPushButton#btnModifier, QPushButton#btnGenerer, QPushButton#btnAfficher, QPushButton#btnNouveauFormulaire { background-color: #F5F0E6; color: #641C2A; border: 1px solid #641C2A; border-radius: 6px; padding: 0 16px; min-height: 40px; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
QPushButton#btnRechercher:hover, QPushButton#btnReinitialiser:hover:hover, QPushButton#btnExporter:hover, QPushButton#btnModifier:hover, QPushButton#btnGenerer:hover, QPushButton#btnAfficher:hover, QPushButton#btnNouveauFormulaire:hover { background-color: #D8A7A7; color: #171717; }
QPushButton#btnRechercher:pressed, QPushButton#btnReinitialiser:pressed:pressed, QPushButton#btnExporter:pressed, QPushButton#btnModifier:pressed, QPushButton#btnGenerer:pressed, QPushButton#btnAfficher:pressed, QPushButton#btnNouveauFormulaire:pressed { background-color: #641C2A; color: #F5F0E6; }
QPushButton#btnSupprimer { background-color: #171717; color: #F5F0E6; border: none; border-radius: 6px; padding: 0 16px; min-height: 42px; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
QPushButton#btnSupprimer:hover { background-color: #8B7D75; }
QPushButton#btnSupprimer:pressed { background-color: #641C2A; }
QTableWidget { background-color: #F5F0E6; color: #171717; border: 1px solid #8B7D75; border-radius: 8px; selection-background-color: #D8A7A7; selection-color: #171717; font-family: &quot;Montserrat&quot;; font-size: 14px; }
QTableWidget::item { padding: 6px; border-bottom: 1px solid #D8A7A7; }
QTableWidget::item:hover { background-color: #D8A7A7; color: #171717; }
QHeaderView::section { background-color: #171717; color: #F5F0E6; text-align: left; padding: 12px 10px; border: none; font-family: &quot;Montserrat&quot;; font-size: 14px; font-weight: 500; }
