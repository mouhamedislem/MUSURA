/* ===== Integrated Gestion des machines styles (scoped) ===== */
QFrame#pageMachines QMainWindow,
QFrame#pageMachines QDialog {
background: #F5F0E6;
}
QFrame#pageMachines QWidget {
font-family: &quot;Montserrat&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
    color: #171717;
    background: transparent;
}
QFrame#pageMachines /* Fond crème de la fenetre : les selecteurs par identifiant ont une
   specificite superieure a &quot;QWidget {
background: transparent
}
QFrame#pageMachines &quot; et
   empechent tout fond noir dans les zones sans widget explicite
   (marges,
QFrame#pageMachines entete,
QFrame#pageMachines espaces entre cartes). */
QMainWindow#MainWindow,
QFrame#pageMachines QWidget#centralwidget {
background: #F5F0E6;
}
QFrame#pageMachines QLabel[role=&quot;h1&quot;] {
font-family: &quot;Cormorant Garamond&quot;, Georgia, serif;
    font-size: 42px;
    font-weight: 700;
