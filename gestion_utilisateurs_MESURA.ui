QPushButton#btnMotDePasseOublie:hover { color: #8B7D75; }
QComboBox { background-color: #F5F0E6; color: #171717; border: 1px solid #8B7D75; border-radius: 6px; padding: 0 12px; min-height: 40px; font-family: &quot;Montserrat&quot;; font-size: 14px; }
QComboBox:hover, QComboBox:on { border: 1px solid #641C2A; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 30px; border: none; }
QComboBox::down-arrow { image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-16.png); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background-color: #F5F0E6; color: #171717; border: 1px solid #8B7D75; selection-background-color: #D8A7A7; selection-color: #171717; outline: none; }
QFrame#statsRow { background-color: #F5F0E6; border: none; }
