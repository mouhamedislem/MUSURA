QLabel#labelStatTotalValue, QLabel#labelStatNouveauxValue { font-family: &quot;Montserrat&quot;; font-size: 26px; font-weight: 600; color: #641C2A; }
QLabel#labelStatTotalTitre, QLabel#labelStatNouveauxTitre, QLabel#labelStatRolesTitre, QLabel#labelChartTitre { color: #8B7D75; font-size: 13px; }
